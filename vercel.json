{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "inventory-public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/product-images/(.*)",
      "dest": "/inventory-public/product-images/$1"
    },
    {
      "src": "/inventory.css",
      "dest": "/inventory-public/inventory.css"
    },
    {
      "src": "/inventory.js",
      "dest": "/inventory-public/inventory.js"
    },
    {
      "src": "/(catalog|dropship|api-center|admin|products/.*)",
      "dest": "/inventory-public/index.html"
    },
    {
      "src": "/",
      "dest": "/inventory-public/index.html"
    }
  ]
}
